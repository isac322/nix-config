+#define TARGET_WINDOW_CACHE_CAPACITY 128
+
+typedef struct {
+    CGRect bounds;
+    pid_t ownerPID;
+} TargetWindowInfo;
+
+static TargetWindowInfo targetWindows[TARGET_WINDOW_CACHE_CAPACITY];
+static size_t targetWindowCount = 0;
+static CFAbsoluteTime targetWindowCacheTime = 0;
+
+static void
+refreshTargetWindows(void)
+{
+    CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+    if (now - targetWindowCacheTime < 0.05)
+        return;
+
+    targetWindowCacheTime = now;
+    targetWindowCount = 0;
+
+    CFArrayRef windows = CGWindowListCopyWindowInfo(
+        kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+        kCGNullWindowID);
+    if (!windows)
+        return;
+
+    CFIndex count = CFArrayGetCount(windows);
+    for (CFIndex i = 0; i < count && targetWindowCount < TARGET_WINDOW_CACHE_CAPACITY; ++i) {
+        CFDictionaryRef window = CFArrayGetValueAtIndex(windows, i);
+        CFNumberRef alphaNumber = CFDictionaryGetValue(window, kCGWindowAlpha);
+        double alpha = 1.0;
+        if (alphaNumber)
+            CFNumberGetValue(alphaNumber, kCFNumberDoubleType, &alpha);
+        if (alpha <= 0.01)
+            continue;
+
+        CFStringRef ownerName = CFDictionaryGetValue(window, kCGWindowOwnerName);
+        CFStringRef windowName = CFDictionaryGetValue(window, kCGWindowName);
+        if (ownerName && windowName &&
+            CFEqual(ownerName, CFSTR("Window Server")) &&
+            CFEqual(windowName, CFSTR("Cursor")))
+            continue;
+
+        CFNumberRef layerNumber = CFDictionaryGetValue(window, kCGWindowLayer);
+        int layer = 0;
+        if (layerNumber)
+            CFNumberGetValue(layerNumber, kCFNumberIntType, &layer);
+        if (layer < 0)
+            continue;
+
+        CFDictionaryRef boundsDictionary = CFDictionaryGetValue(window, kCGWindowBounds);
+        CGRect bounds;
+        if (!boundsDictionary || !CGRectMakeWithDictionaryRepresentation(boundsDictionary, &bounds))
+            continue;
+
+        CFNumberRef ownerNumber = CFDictionaryGetValue(window, kCGWindowOwnerPID);
+        pid_t ownerPID = -1;
+        if (!ownerNumber || !CFNumberGetValue(ownerNumber, kCFNumberIntType, &ownerPID))
+            continue;
+
+        targetWindows[targetWindowCount].bounds = bounds;
+        targetWindows[targetWindowCount].ownerPID = ownerPID;
+        ++targetWindowCount;
+    }
+
+    CFRelease(windows);
+}
+
+static rfbBool
+pointIsInsideTargetWindow(CGPoint position)
+{
+    refreshTargetWindows();
+    for (size_t i = 0; i < targetWindowCount; ++i) {
+        if (targetWindows[i].ownerPID == applicationPID &&
+            CGRectContainsPoint(targetWindows[i].bounds, position))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static rfbBool
+targetWindowIsTopmostAtPoint(CGPoint position)
+{
+    refreshTargetWindows();
+    for (size_t i = 0; i < targetWindowCount; ++i) {
+        if (CGRectContainsPoint(targetWindows[i].bounds, position))
+            return targetWindows[i].ownerPID == applicationPID;
+    }
+    return FALSE;
+}
+
+static rfbBool
+targetApplicationIsFrontmost(void)
+{
+    if (!applicationBundleIdentifier)
+        return TRUE;
+    if (applicationPID <= 0)
+        return FALSE;
+
+    ProcessSerialNumber targetProcess;
+    ProcessSerialNumber frontProcess;
+    Boolean sameProcess = FALSE;
+    if (GetProcessForPID(applicationPID, &targetProcess) != noErr ||
+        GetFrontProcess(&frontProcess) != noErr ||
+        SameProcess(&targetProcess, &frontProcess, &sameProcess) != noErr)
+        return FALSE;
+    return sameProcess;
+}
+
+static void
+activateTargetApplication(void)
+{
+    ProcessSerialNumber targetProcess;
+    if (applicationPID > 0 && GetProcessForPID(applicationPID, &targetProcess) == noErr) {
+        SetFrontProcessWithOptions(
+            &targetProcess,
+            kSetFrontProcessFrontWindowOnly | kSetFrontProcessCausedByUser);
+    }
+}
+static void
+postMouseButtonState(CGPoint position, int buttonMask)
+{
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    CGPostMouseEvent(position, TRUE, 3,
+                     (buttonMask & (1 << 0)) ? TRUE : FALSE,
+                     (buttonMask & (1 << 2)) ? TRUE : FALSE,
+                     (buttonMask & (1 << 1)) ? TRUE : FALSE);
+#pragma clang diagnostic pop
+}
