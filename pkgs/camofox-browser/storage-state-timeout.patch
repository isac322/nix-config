+// Session teardown awaits this checkpoint, and every later request for the
+// same user queues behind that teardown. A storageState() call that never
+// settles must therefore give up; the previous snapshot on disk stays in place.
+const STORAGE_STATE_TIMEOUT_MS = 60_000;
+
+async function captureStorageState(context, options, timeoutMs) {
+  let timer;
+  try {
+    return await Promise.race([
+      context.storageState(options),
+      new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`storageState timed out after ${timeoutMs}ms`)), timeoutMs);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
