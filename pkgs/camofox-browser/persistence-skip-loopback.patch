+// A local dev or test server gets a new port, and so a new origin, on every
+// run. Each stored origin costs a navigation on restore and on capture, so
+// localStorage for loopback origins is not kept.
+function isLoopbackOrigin(origin) {
+  try {
+    const hostname = new URL(origin).hostname.replace(/\.$/, '');
+    return hostname === 'localhost' || hostname.endsWith('.localhost')
+      || hostname === '[::1]' || /^127(\.\d{1,3}){3}$/.test(hostname);
+  } catch {
+    return false;
+  }
+}
